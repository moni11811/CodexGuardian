<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.moni.codexguardian</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string>
    <string>-i</string>
    <string>HOME=__GUARDIAN_HOME__</string>
    <string>PATH=/usr/bin:/bin:/usr/sbin:/sbin</string>
    <string>/Applications/Codex Guardian.app/Contents/MacOS/CodexGuardian</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/tmp/com.moni.codexguardian.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.moni.codexguardian.stderr.log</string>
</dict>
</plist>
